{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loveca-card-list-sync",
  "main": "sync-worker/index.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://loveca-card-list.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loveca-card-list-sync",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "sync-worker/migrations"
    }
  ]
}
